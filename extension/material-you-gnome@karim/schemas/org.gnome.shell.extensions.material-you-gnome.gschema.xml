<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.material-you-gnome"
          path="/org/gnome/shell/extensions/material-you-gnome/">

    <!-- Widgets du bureau. Chacun peut être coupé sans toucher au code : la
         couche les instancie à la demande et resserre la pile. -->
    <key name="show-clock" type="b">
      <default>true</default>
      <summary>Afficher l'horloge</summary>
    </key>
    <key name="show-quote" type="b">
      <default>true</default>
      <summary>Afficher la citation</summary>
    </key>
    <key name="show-media" type="b">
      <default>true</default>
      <summary>Afficher la carte média</summary>
    </key>
    <key name="show-calendar" type="b">
      <default>true</default>
      <summary>Afficher le calendrier</summary>
    </key>
    <key name="show-weather" type="b">
      <default>true</default>
      <summary>Afficher la météo</summary>
    </key>
    <key name="show-resources" type="b">
      <default>true</default>
      <summary>Afficher les ressources système</summary>
    </key>
    <key name="show-usercard" type="b">
      <default>true</default>
      <summary>Afficher la carte utilisateur</summary>
    </key>

    <!-- Désactivé par défaut : le tableau de bord commence à être chargé, et
         ce widget interroge un service tiers. -->
    <key name="show-anilist" type="b">
      <default>true</default>
      <summary>Afficher les séries AniList en cours</summary>
    </key>

    <key name="anilist-user" type="s">
      <default>'PedroKarim64'</default>
      <summary>Pseudo AniList</summary>
      <description>Vide, aucune requête n'est émise.</description>
    </key>

    <key name="anilist-count" type="i">
      <default>3</default>
      <range min="1" max="8"/>
      <summary>Nombre d'entrées par section</summary>
    </key>

    <key name="show-devices" type="b">
      <default>true</default>
      <summary>Afficher les appareils connectés</summary>
      <description>Périphériques rapportant un niveau de batterie, via UPower.</description>
    </key>

    <key name="show-worldclocks" type="b">
      <default>false</default>
      <summary>Afficher les horloges mondiales</summary>
    </key>

    <!-- Désactivé par défaut : plusieurs indicateurs de barre très répandus,
         « system-monitor » en tête, affichent déjà ce débit. -->
    <key name="show-network" type="b">
      <default>false</default>
      <summary>Afficher le débit réseau</summary>
    </key>

    <key name="show-notes" type="b">
      <default>false</default>
      <summary>Afficher le bloc-notes</summary>
    </key>

    <!-- Le texte vit ici plutôt que dans un fichier : le widget et le panneau
         de réglages l'éditent alors tous les deux, sans deux sources à
         réconcilier. -->
    <key name="notes-text" type="s">
      <default>''</default>
      <summary>Contenu du bloc-notes</summary>
    </key>

    <key name="show-pomodoro" type="b">
      <default>false</default>
      <summary>Afficher le minuteur pomodoro</summary>
    </key>

    <key name="pomodoro-work" type="i">
      <default>25</default>
      <range min="1" max="120"/>
      <summary>Durée d'une session de travail, en minutes</summary>
    </key>

    <key name="pomodoro-break" type="i">
      <default>5</default>
      <range min="1" max="60"/>
      <summary>Durée d'une pause, en minutes</summary>
    </key>

    <!-- « Libellé|Zone IANA ». On n'utilise pas org.gnome.shell.world-clocks :
         cette clé stocke des localisations GWeather sérialisées, pénibles à
         écrire depuis un panneau de préférences. -->
    <key name="world-clocks" type="as">
      <default>['Sydney|Australia/Sydney','Tokyo|Asia/Tokyo','Londres|Europe/London','New York|America/New_York']</default>
      <summary>Fuseaux affichés</summary>
    </key>

    <key name="clock-style" type="s">
      <choices>
        <choice value="cookie"/>
        <choice value="digital"/>
        <choice value="pixel"/>
      </choices>
      <default>'cookie'</default>
      <summary>Style d'horloge</summary>
    </key>

    <key name="quote-text" type="s">
      <default>''</default>
      <summary>Texte de la citation</summary>
    </key>

    <key name="show-lyrics" type="b">
      <default>true</default>
      <summary>Afficher les paroles synchronisées</summary>
      <description>Interroge lrclib.net à chaque changement de piste.</description>
    </key>

    <!-- Barre -->
    <!-- Les quatre formes de leur BarConfig. Axe indépendant de
         `floating-panel`, qui correspond à leur borderless « transparent ». -->
    <key name="bar-style" type="s">
      <choices>
        <choice value="hug"/>
        <choice value="float"/>
        <choice value="islands"/>
        <choice value="m3"/>
      </choices>
      <default>'islands'</default>
      <summary>Forme de la barre</summary>
    </key>

    <key name="floating-panel" type="b">
      <default>false</default>
      <summary>Barre flottante</summary>
      <description>
        Rend le fond de la barre transparent, ne laissant que les îlots. Plus
        proche d'illogical-impulse, au prix du contenu des fenêtres maximisées
        qui transparaît sous la barre.
      </description>
    </key>

    <key name="screen-corners" type="b">
      <default>false</default>
      <summary>Coins d'écran arrondis</summary>
    </key>

    <key name="screen-corner-radius" type="i">
      <default>14</default>
      <range min="4" max="48"/>
      <summary>Rayon des coins d'écran</summary>
    </key>

    <key name="desktop-margin" type="i">
      <default>48</default>
      <range min="0" max="200"/>
      <summary>Marge des widgets aux bords de l'écran</summary>
    </key>
  </schema>
</schemalist>
